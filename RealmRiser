const bosses = [
  { round:10, name:"Goblin King", emoji:"👑", hp:170, attack:16, defense:5, coins:80, xp:80 },
  { round:20, name:"Dire Wolf Alpha", emoji:"🐺", hp:270, attack:22, defense:7, coins:120, xp:120 },
  { round:30, name:"Skeleton Warlord", emoji:"☠️", hp:400, attack:29, defense:10, coins:170, xp:170 },
  { round:40, name:"Cave Troll", emoji:"🧌", hp:560, attack:36, defense:12, coins:230, xp:230 },
  { round:50, name:"Ancient Golem", emoji:"🗿", hp:760, attack:45, defense:16, coins:300, xp:300 },
  { round:60, name:"Storm Griffin", emoji:"🦅", hp:980, attack:55, defense:18, coins:390, xp:390 },
  { round:70, name:"Dread Knight", emoji:"🗡️", hp:1250, attack:66, defense:22, coins:500, xp:500 },
  { round:80, name:"Earth Hydra", emoji:"🐉", hp:1600, attack:78, defense:26, coins:650, xp:650 },
  { round:90, name:"Ancient Dragon", emoji:"🐲", hp:2050, attack:92, defense:30, coins:850, xp:850 },
  { round:100, name:"EARTH TITAN", emoji:"🌎", hp:3000, attack:115, defense:36, coins:1500, xp:1500, worldBoss:true },
];

const defaultState = () => ({
  round: 1,
  world: 1,
  coins: 0,
  eventCoins: 0,
  level: 1,
  xp: 0,
  xpToNext: 50,
  baseMaxHp: 100,
  hp: 100,
  baseAttack: 10,
  baseDefense: 2,
  potions: 2,
  weapons: [],
  armor: [],
  pets: [],
  equippedWeapon: null,
  equippedArmor: null,
  equippedPet: null,
  enemy: null,
  enemyHp: 0,
  battleWon: false,
  merchantAvailable: false,
  frozenEnemy: false,
});

let state = loadState() || defaultState();
let currentTab = "weapons";

const el = id => document.getElementById(id);

function rankIndex(rank) {
  return RANKS.indexOf(rank);
}

function getWeapon() {
  return weaponCatalog.find(i => i.id === state.equippedWeapon);
}

function getArmor() {
  return armorCatalog.find(i => i.id === state.equippedArmor);
}

function getPet() {
  return petCatalog.find(i => i.id === state.equippedPet);
}

function maxHp() {
  const armor = getArmor();
  return state.baseMaxHp + (armor?.hp || 0);
}

function totalAttack() {
  const weapon = getWeapon();
  return state.baseAttack + (weapon?.attack || 0);
}

function totalDefense() {
  const armor = getArmor();
  return state.baseDefense + (armor?.defense || 0);
}

function saveState(showMessage = true) {
  localStorage.setItem("rankbound_save_v01", JSON.stringify(state));
  if (showMessage) addLog("💾 Game saved.");
}

function loadState() {
  try {
    const raw = localStorage.getItem("rankbound_save_v01");
    return raw ? JSON.parse(raw) : null;
  } catch {
    return null;
  }
}

function resetGame() {
  if (!confirm("Reset ALL progress? This cannot be undone.")) return;
  localStorage.removeItem("rankbound_save_v01");
  state = defaultState();
  spawnEnemy();
  addLog("🌍 A new adventure begins on Earth.");
  render();
}

function worldName() {
  if (state.round <= 100) return "🌍 Earth";
  if (state.round <= 200) return "🍄 Mushroom Planet";
  if (state.round <= 300) return "☀️ Sun World";
  return "🌌 Unknown World";
}

function scaleForRound(round) {
  return 1 + (round - 1) * 0.085;
}

function spawnEnemy() {
  state.battleWon = false;
  state.frozenEnemy = false;

  const bossTemplate = bosses.find(b => b.round === state.round);
  if (bossTemplate) {
    state.enemy = { ...bossTemplate, boss:true };
  } else {
    const m = monsters[Math.min(monsters.length - 1, Math.floor((state.round - 1) / 4))];
    const scale = scaleForRound(state.round);
    state.enemy = {
      ...m,
      hp: Math.round(m.hp * scale),
      attack: Math.round(m.attack * (1 + (state.round - 1) * 0.055)),
      defense: Math.round(m.defense + state.round * 0.12),
      coins: Math.round(m.coins * (1 + state.round * 0.06)),
      xp: Math.round(m.xp * (1 + state.round * 0.045)),
      boss:false
    };
  }

  state.enemyHp = state.enemy.hp;
  addLog(`⚠️ ${state.enemy.name} appeared!`);
  render();
}

function addLog(message) {
  const log = el("battleLog");
  if (!log) return;
  const line = document.createElement("div");
  line.className = "log-line";
  line.textContent = message;
  log.prepend(line);
}

function attackEnemy() {
  if (state.battleWon || state.hp <= 0) return;

  const crit = Math.random() < 0.12;
  let damage = Math.max(1, totalAttack() - state.enemy.defense + Math.floor(Math.random() * 5));
  if (crit) damage = Math.round(damage * 1.8);

  const pet = getPet();

  if (pet?.ability === "combat") {
    damage += pet.power;
    addLog(`🐾 ${pet.name} joins your attack for +${pet.power} damage!`);
  }

  if (pet?.ability === "thunder" && Math.random() < 0.20) {
    damage += pet.power;
    addLog(`⚡ ${pet.name} calls lightning for +${pet.power} damage!`);
  }

  if (pet?.ability === "ice" && Math.random() < 0.20) {
    state.frozenEnemy = true;
    addLog(`❄️ ${pet.name} freezes the enemy!`);
  }

  state.enemyHp = Math.max(0, state.enemyHp - damage);
  addLog(`${crit ? "💥 CRITICAL! " : "⚔️ "}You deal ${damage} damage.`);

  if (pet?.ability === "heal" && Math.random() < 0.25) {
    const oldHp = state.hp;
    state.hp = Math.min(maxHp(), state.hp + pet.power);
    addLog(`💚 ${pet.name} heals you for ${state.hp - oldHp} HP.`);
  }

  if (state.enemyHp <= 0) {
    winBattle();
    return;
  }

  enemyTurn();
  render();
}

function enemyTurn() {
  if (state.frozenEnemy) {
    state.frozenEnemy = false;
    addLog(`🧊 ${state.enemy.name} is frozen and misses its turn!`);
    return;
  }

  const damage = Math.max(1, state.enemy.attack - totalDefense() + Math.floor(Math.random() * 4));
  state.hp = Math.max(0, state.hp - damage);
  addLog(`💢 ${state.enemy.name} hits you for ${damage} damage.`);

  if (state.hp <= 0) {
    const lost = Math.floor(state.coins * 0.10);
    state.coins -= lost;
    state.hp = maxHp();
    addLog(`💀 You were defeated. You lost ${lost} coins and recovered at camp.`);
    spawnEnemy();
  }
}

function winBattle() {
  state.battleWon = true;
  state.coins += state.enemy.coins;
  gainXp(state.enemy.xp);
  addLog(`🏆 Victory! +${state.enemy.coins} coins and +${state.enemy.xp} XP.`);

  if (state.enemy.boss) {
    const chance = state.enemy.worldBoss ? 0.75 : 0.30;
    if (Math.random() < chance) {
      const amount = state.enemy.worldBoss ? 3 : 1;
      state.eventCoins += amount;
      addLog(`✨ Boss drop! You found ${amount} Event Coin${amount > 1 ? "s" : ""}!`);
    }

    bossDrop();
  } else {
    normalDrop();
  }

  if (state.round % 5 === 0 || Math.random() < 0.15) {
    state.merchantAvailable = true;
    addLog("🧙 A wandering merchant has appeared.");
  } else {
    state.merchantAvailable = false;
  }

  saveState(false);
  render();
}

function gainXp(amount) {
  state.xp += amount;

  while (state.xp >= state.xpToNext) {
    state.xp -= state.xpToNext;
    state.level++;
    state.xpToNext = Math.round(state.xpToNext * 1.22);
    state.baseMaxHp += 12;
    state.baseAttack += 3;
    state.baseDefense += 1;
    state.hp = maxHp();
    addLog(`🌟 LEVEL UP! You are now Level ${state.level}. Your stats increased!`);
  }
}

function normalDrop() {
  if (Math.random() > 0.17) return;

  const possible = [
    ...weaponCatalog.filter(i => rankIndex(i.rank) <= 1),
    ...armorCatalog.filter(i => rankIndex(i.rank) <= 1)
  ];
  const item = possible[Math.floor(Math.random() * possible.length)];
  addItem(item);
  addLog(`🎁 Rare drop: ${item.rank}-Rank ${item.name}!`);
}

function bossDrop() {
  const maxRank = state.round >= 70 ? 2 : state.round >= 30 ? 1 : 0;
  const pool = [
    ...weaponCatalog.filter(i => rankIndex(i.rank) <= maxRank),
    ...armorCatalog.filter(i => rankIndex(i.rank) <= maxRank),
    ...petCatalog.filter(i => rankIndex(i.rank) <= Math.min(1, maxRank))
  ];
  const item = pool[Math.floor(Math.random() * pool.length)];
  addItem(item);
  addLog(`👑 BOSS DROP: ${item.rank}-Rank ${item.name}!`);
}

function addItem(item) {
  if (weaponCatalog.some(i => i.id === item.id)) {
    if (!state.weapons.includes(item.id)) state.weapons.push(item.id);
  } else if (armorCatalog.some(i => i.id === item.id)) {
    if (!state.armor.includes(item.id)) state.armor.push(item.id);
  } else if (petCatalog.some(i => i.id === item.id)) {
    if (!state.pets.includes(item.id)) state.pets.push(item.id);
  }
}

function usePotion() {
  if (state.potions <= 0 || state.hp >= maxHp() || state.battleWon) return;
  const heal = Math.round(maxHp() * 0.40);
  const before = state.hp;
  state.hp = Math.min(maxHp(), state.hp + heal);
  state.potions--;
  addLog(`🧪 Potion restores ${state.hp - before} HP.`);
  enemyTurn();
  render();
}

function nextRound() {
  if (!state.battleWon) return;

  if (state.round === 100) {
    addLog("🌌 EARTH COMPLETE! The portal to Mushroom Planet will open in a future update!");
    alert("🌍 EARTH COMPLETE!\n\nYou defeated the Earth Titan!\n\n🍄 Mushroom Planet is planned for Version 0.2+.");
    return;
  }

  state.round++;
  state.hp = Math.min(maxHp(), state.hp + Math.round(maxHp() * 0.15));
  state.merchantAvailable = false;
  spawnEnemy();
  saveState(false);
}

function equip(type, id) {
  if (type === "weapons") state.equippedWeapon = id;
  if (type === "armor") {
    const oldMax = maxHp();
    state.equippedArmor = id;
    const newMax = maxHp();
    state.hp = Math.min(newMax, state.hp + Math.max(0, newMax - oldMax));
  }
  if (type === "pets") state.equippedPet = id;

  const catalog = type === "weapons" ? weaponCatalog : type === "armor" ? armorCatalog : petCatalog;
  const item = catalog.find(i => i.id === id);
  addLog(`✅ Equipped ${item.name}.`);
  saveState(false);
  render();
}

function merchantStock() {
  const allowedRank = state.round >= 60 ? 2 : state.round >= 25 ? 1 : 0;

  let pool = [
    ...weaponCatalog.filter(i => rankIndex(i.rank) <= allowedRank),
    ...armorCatalog.filter(i => rankIndex(i.rank) <= allowedRank),
    ...petCatalog.filter(i => rankIndex(i.rank) <= Math.min(1, allowedRank))
  ];

  pool = [...pool].sort(() => Math.random() - 0.5).slice(0, 5);

  return [
    ...pool,
    { id:"potion_shop", name:"Health Potion", rank:"D", price:35, shopType:"potion", desc:"Restores 40% max HP in battle." }
  ];
}

let currentMerchantStock = [];

function openMerchant() {
  if (!state.merchantAvailable) return;
  currentMerchantStock = merchantStock();
  el("merchantPanel").classList.remove("hidden");
  renderMerchant();
}

function renderMerchant() {
  const box = el("merchantItems");
  box.innerHTML = "";

  currentMerchantStock.forEach(item => {
    const owned =
      state.weapons.includes(item.id) ||
      state.armor.includes(item.id) ||
      state.pets.includes(item.id);

    const div = document.createElement("div");
    div.className = "shop-item";
    div.innerHTML = `
      <span class="rank">${item.rank}</span>
      <h3>${item.name}</h3>
      <p>${item.desc}</p>
      <button ${owned && item.shopType !== "potion" ? "disabled" : ""}>
        ${owned && item.shopType !== "potion" ? "Owned" : `Buy · ${item.price} 🪙`}
      </button>
    `;

    div.querySelector("button").onclick = () => buyItem(item);
    box.appendChild(div);
  });
}

function buyItem(item) {
  if (state.coins < item.price) {
    addLog("❌ Not enough coins.");
    return;
  }

  state.coins -= item.price;

  if (item.shopType === "potion") {
    state.potions++;
    addLog("🧪 Bought 1 Health Potion.");
  } else {
    addItem(item);
    addLog(`🛒 Bought ${item.rank}-Rank ${item.name}.`);
  }

  saveState(false);
  render();
  renderMerchant();
}

function renderInventory() {
  const box = el("inventoryList");
  box.innerHTML = "";

  const catalog = currentTab === "weapons" ? weaponCatalog : currentTab === "armor" ? armorCatalog : petCatalog;
  const ownedIds = currentTab === "weapons" ? state.weapons : currentTab === "armor" ? state.armor : state.pets;
  const equippedId = currentTab === "weapons" ? state.equippedWeapon : currentTab === "armor" ? state.equippedArmor : state.equippedPet;

  if (ownedIds.length === 0) {
    box.innerHTML = `<div class="item"><div class="item-desc">No ${currentTab} yet. Defeat monsters, bosses, or visit merchants.</div></div>`;
    return;
  }

  ownedIds
    .map(id => catalog.find(i => i.id === id))
    .filter(Boolean)
    .sort((a,b) => rankIndex(b.rank) - rankIndex(a.rank))
    .forEach(item => {
      const div = document.createElement("div");
      div.className = "item";
      div.innerHTML = `
        <div class="item-top">
          <div class="item-name">${item.name}</div>
          <span class="rank">${item.rank}</span>
        </div>
        <div class="item-desc">${item.desc}</div>
        <button ${equippedId === item.id ? "disabled" : ""}>
          ${equippedId === item.id ? "Equipped" : "Equip"}
        </button>
      `;
      div.querySelector("button").onclick = () => equip(currentTab, item.id);
      box.appendChild(div);
    });
}

function render() {
  if (!state.enemy) spawnEnemy();

  el("worldName").textContent = worldName();
  el("roundText").textContent = `${state.round} / 100`;
  el("levelText").textContent = state.level;
  el("coinText").textContent = `${state.coins} 🪙`;
  el("eventCoinText").textContent = `${state.eventCoins} ✨`;

  el("playerHpText").textContent = `${state.hp} / ${maxHp()}`;
  el("playerHpBar").style.width = `${Math.max(0, state.hp / maxHp() * 100)}%`;

  el("xpText").textContent = `${state.xp} / ${state.xpToNext}`;
  el("xpBar").style.width = `${Math.min(100, state.xp / state.xpToNext * 100)}%`;

  el("playerStats").innerHTML = `
    <div class="stat">⚔️ Attack<br><b>${totalAttack()}</b></div>
    <div class="stat">🛡️ Defense<br><b>${totalDefense()}</b></div>
    <div class="stat">❤️ Max HP<br><b>${maxHp()}</b></div>
    <div class="stat">🧪 Potions<br><b>${state.potions}</b></div>
  `;

  const weapon = getWeapon();
  const armor = getArmor();
  const pet = getPet();

  el("weaponText").textContent = `Weapon: ${weapon ? `[${weapon.rank}] ${weapon.name}` : "None"}`;
  el("armorText").textContent = `Armor: ${armor ? `[${armor.rank}] ${armor.name}` : "None"}`;
  el("petText").textContent = `Pet: ${pet ? `[${pet.rank}] ${pet.name}` : "None"}`;

  el("enemyName").textContent = state.enemy.name;
  el("enemyEmoji").textContent = state.enemy.emoji;
  el("enemyHpText").textContent = `${state.enemyHp} / ${state.enemy.hp}`;
  el("enemyHpBar").style.width = `${Math.max(0, state.enemyHp / state.enemy.hp * 100)}%`;

  el("enemyStats").innerHTML = `
    <div class="stat">⚔️ Attack<br><b>${state.enemy.attack}</b></div>
    <div class="stat">🛡️ Defense<br><b>${state.enemy.defense}</b></div>
    <div class="stat">🪙 Reward<br><b>${state.enemy.coins}</b></div>
    <div class="stat">⭐ XP<br><b>${state.enemy.xp}</b></div>
  `;

  const tag = el("encounterTag");
  if (state.enemy.worldBoss) {
    tag.textContent = "🌎 WORLD BOSS";
    tag.className = "encounter-tag world-boss-tag";
  } else if (state.enemy.boss) {
    tag.textContent = "👑 BOSS ENCOUNTER";
    tag.className = "encounter-tag boss-tag";
  } else {
    tag.textContent = "NORMAL ENCOUNTER";
    tag.className = "encounter-tag";
  }

  el("attackBtn").disabled = state.battleWon;
  el("healBtn").disabled = state.battleWon || state.potions <= 0 || state.hp >= maxHp();
  el("potionCount").textContent = state.potions;

  el("nextBtn").classList.toggle("hidden", !state.battleWon);
  el("merchantBtn").classList.toggle("hidden", !(state.battleWon && state.merchantAvailable));

  renderInventory();
}

document.querySelectorAll(".tab").forEach(btn => {
  btn.addEventListener("click", () => {
    document.querySelectorAll(".tab").forEach(b => b.classList.remove("active"));
    btn.classList.add("active");
    currentTab = btn.dataset.tab;
    renderInventory();
  });
});

el("attackBtn").onclick = attackEnemy;
el("healBtn").onclick = usePotion;
el("nextBtn").onclick = nextRound;
el("merchantBtn").onclick = openMerchant;
el("closeMerchantBtn").onclick = () => el("merchantPanel").classList.add("hidden");
el("saveBtn").onclick = () => saveState(true);
el("resetBtn").onclick = resetGame;

if (!state.enemy) spawnEnemy();
render();
addLog("⚔️ Welcome to Rankbound. Defeat monsters, level up, collect gear, and conquer Earth!");
