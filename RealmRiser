function dragonPalette(element){
if(element==="ice")return["#aee8f7","#3f8da7","#e9fcff","#67dfff"];
if(element==="thunder")return["#d7c05a","#65528c","#fff1a2","#ffe45a"];
if(element==="void")return["#372346","#140b19","#c28cff","#8d4cff"];
if(element==="celestial")return["#e8d6f8","#8397d9","#fff5d7","#fff2a8"];
return["#b94f3d","#752d29","#f0b07c","#ff704c"];
}
function drawDragon(x,y,scale,element){
ctx.save();ctx.translate(x,y);ctx.scale(scale,scale);
const c=dragonPalette(element);

// shadow
ctx.fillStyle="rgba(0,0,0,.34)";
ctx.beginPath();ctx.ellipse(0,67,65,12,0,0,Math.PI*2);ctx.fill();

// tail
ctx.strokeStyle=c[0];ctx.lineWidth=18;ctx.lineCap="round";
ctx.beginPath();ctx.moveTo(-35,28);ctx.quadraticCurveTo(-80,33,-93,4);ctx.quadraticCurveTo(-102,-17,-80,-30);ctx.stroke();

// body gradient
let dg=ctx.createLinearGradient(-45,-15,45,48);
dg.addColorStop(0,c[0]);dg.addColorStop(1,c[1]);
ctx.fillStyle=dg;
ctx.beginPath();
ctx.ellipse(0,24,47,36,-.05,0,Math.PI*2);
ctx.fill();

// belly plates
ctx.fillStyle=c[2];
for(let i=0;i<5;i++){
ctx.beginPath();
ctx.roundRect(15+i*2,5+i*9,18,7,4);ctx.fill();
}

// wings
ctx.fillStyle=c[1];
ctx.beginPath();
ctx.moveTo(-10,5);ctx.lineTo(-72,-50);ctx.lineTo(-50,-2);ctx.lineTo(-66,18);ctx.lineTo(-22,20);ctx.closePath();ctx.fill();
ctx.beginPath();
ctx.moveTo(12,0);ctx.lineTo(58,-55);ctx.lineTo(48,-8);ctx.lineTo(74,5);ctx.lineTo(25,22);ctx.closePath();ctx.fill();
ctx.strokeStyle="rgba(255,255,255,.12)";ctx.lineWidth=2;
ctx.beginPath();ctx.moveTo(-14,4);ctx.lineTo(-65,-43);ctx.stroke();
ctx.beginPath();ctx.moveTo(16,1);ctx.lineTo(55,-48);ctx.stroke();

// neck and head
ctx.fillStyle=c[0];
ctx.beginPath();ctx.ellipse(30,-3,22,32,-.25,0,Math.PI*2);ctx.fill();
ctx.beginPath();ctx.ellipse(47,-27,30,22,-.2,0,Math.PI*2);ctx.fill();

// muzzle
ctx.fillStyle=c[2];
ctx.beginPath();ctx.ellipse(67,-18,19,9,-.1,0,Math.PI*2);ctx.fill();

// horns
ctx.fillStyle="#e4d1a8";
ctx.beginPath();ctx.moveTo(30,-44);ctx.lineTo(26,-70);ctx.lineTo(42,-46);ctx.closePath();ctx.fill();
ctx.beginPath();ctx.moveTo(49,-46);ctx.lineTo(61,-68);ctx.lineTo(62,-39);ctx.closePath();ctx.fill();

// spines
ctx.fillStyle=c[3];
for(let i=0;i<5;i++){
let sx=-27+i*13;
ctx.beginPath();ctx.moveTo(sx,-5);ctx.lineTo(sx+5,-19-(i%2)*4);ctx.lineTo(sx+11,-4);ctx.closePath();ctx.fill();
}

// eye
ctx.fillStyle=c[3];ctx.beginPath();ctx.arc(54,-30,4,0,Math.PI*2);ctx.fill();
ctx.fillStyle="#111";ctx.beginPath();ctx.arc(55,-30,1.7,0,Math.PI*2);ctx.fill();

// nostril
ctx.fillStyle="#241616";ctx.beginPath();ctx.arc(73,-20,1.7,0,Math.PI*2);ctx.fill();

// legs / claws
ctx.strokeStyle=c[1];ctx.lineWidth=11;ctx.lineCap="round";
for(const [lx,dx] of[[-22,-28],[12,8],[28,30]]){
ctx.beginPath();ctx.moveTo(lx,44);ctx.lineTo(dx,67);ctx.stroke();
ctx.strokeStyle="#25222a";ctx.lineWidth=5;
ctx.beginPath();ctx.moveTo(dx,67);ctx.lineTo(dx+8,67);ctx.stroke();
ctx.strokeStyle=c[1];ctx.lineWidth=11;
}

// scale highlights
ctx.strokeStyle="rgba(255,255,255,.16)";ctx.lineWidth=1;
for(let i=0;i<12;i++){
let sx=-25+(i%6)*11, sy=11+Math.floor(i/6)*12;
ctx.beginPath();ctx.arc(sx,sy,5,Math.PI*.1,Math.PI*.9);ctx.stroke();
}
ctx.restore();
}

function drawPet(){
const p=pet();if(!p)return;
let x=320,y=445;if(state.petAttackAnim>0)x+=Math.sin((22-state.petAttackAnim)/22*Math.PI)*110;
if(p.species==="wolf")drawWolf(x,y,0.9,p.element);else drawDragon(x,y,0.82,p.element);
}

function drawMonsterShape(kind,x,y,scale=1){
ctx.save();ctx.translate(x,y);ctx.scale(scale,scale);
ctx.fillStyle="rgba(0,0,0,.36)";
ctx.beginPath();ctx.ellipse(0,72,64,13,0,0,Math.PI*2);ctx.fill();

if(kind==="crawler"){
let g=ctx.createLinearGradient(-40,-20,40,45);g.addColorStop(0,"#70805d");g.addColorStop(1,"#344431");
ctx.fillStyle=g;ctx.beginPath();ctx.ellipse(0,22,50,34,0,0,Math.PI*2);ctx.fill();
ctx.fillStyle="#667b5a";ctx.beginPath();ctx.ellipse(4,-11,35,27,-.1,0,Math.PI*2);ctx.fill();
ctx.strokeStyle="#2e392c";ctx.lineWidth=8;ctx.lineCap="round";
for(const side of[-1,1]){ctx.beginPath();ctx.moveTo(side*34,24);ctx.lineTo(side*58,52);ctx.stroke();ctx.beginPath();ctx.moveTo(side*20,36);ctx.lineTo(side*38,65);ctx.stroke()}
ctx.fillStyle="#e8e4c7";ctx.beginPath();ctx.arc(-9,-15,5,0,Math.PI*2);ctx.fill();ctx.beginPath();ctx.arc(14,-13,5,0,Math.PI*2);ctx.fill();
ctx.fillStyle="#121514";ctx.beginPath();ctx.arc(-9,-15,2,0,Math.PI*2);ctx.fill();ctx.beginPath();ctx.arc(14,-13,2,0,Math.PI*2);ctx.fill();
ctx.strokeStyle="#2c2620";ctx.lineWidth=2;ctx.beginPath();ctx.moveTo(-9,3);ctx.quadraticCurveTo(7,13,22,2);ctx.stroke();
}
else if(kind==="brute"||kind==="boss1"){
let g=ctx.createLinearGradient(-50,-40,50,70);g.addColorStop(0,"#80694d");g.addColorStop(1,"#443829");
ctx.fillStyle=g;ctx.beginPath();ctx.roundRect(-46,-4,92,76,24);ctx.fill();
ctx.fillStyle="#92785a";ctx.beginPath();ctx.arc(0,-32,34,0,Math.PI*2);ctx.fill();
ctx.fillStyle="#392d23";ctx.beginPath();ctx.arc(0,-40,33,Math.PI,Math.PI*2);ctx.fill();
ctx.fillStyle="#f1e4ca";ctx.beginPath();ctx.arc(-11,-36,5,0,Math.PI*2);ctx.fill();ctx.beginPath();ctx.arc(11,-36,5,0,Math.PI*2);ctx.fill();
ctx.fillStyle="#15110f";ctx.beginPath();ctx.arc(-11,-36,2,0,Math.PI*2);ctx.fill();ctx.beginPath();ctx.arc(11,-36,2,0,Math.PI*2);ctx.fill();
ctx.strokeStyle="#3a2e23";ctx.lineWidth=12;ctx.beginPath();ctx.moveTo(-36,22);ctx.lineTo(-60,58);ctx.stroke();ctx.beginPath();ctx.moveTo(36,22);ctx.lineTo(60,58);ctx.stroke();
ctx.fillStyle="#d8c9a7";ctx.beginPath();ctx.moveTo(-8,-16);ctx.lineTo(-2,-7);ctx.lineTo(4,-17);ctx.closePath();ctx.fill();
}
else if(kind==="horn"||kind==="boss2"){
let g=ctx.createLinearGradient(-50,-40,50,65);g.addColorStop(0,"#754d42");g.addColorStop(1,"#3b2926");
ctx.fillStyle=g;ctx.beginPath();ctx.ellipse(0,26,56,43,0,0,Math.PI*2);ctx.fill();
ctx.fillStyle="#7e5546";ctx.beginPath();ctx.ellipse(0,-17,40,32,0,0,Math.PI*2);ctx.fill();
ctx.fillStyle="#d5c2a0";ctx.beginPath();ctx.moveTo(-28,-39);ctx.lineTo(-56,-70);ctx.lineTo(-15,-46);ctx.closePath();ctx.fill();ctx.beginPath();ctx.moveTo(28,-39);ctx.lineTo(56,-70);ctx.lineTo(15,-46);ctx.closePath();ctx.fill();
ctx.fillStyle="#f0e6d4";ctx.beginPath();ctx.arc(-12,-20,5,0,Math.PI*2);ctx.fill();ctx.beginPath();ctx.arc(12,-20,5,0,Math.PI*2);ctx.fill();
ctx.fillStyle="#111";ctx.beginPath();ctx.arc(-12,-20,2,0,Math.PI*2);ctx.fill();ctx.beginPath();ctx.arc(12,-20,2,0,Math.PI*2);ctx.fill();
ctx.strokeStyle="#2f211f";ctx.lineWidth=2;ctx.beginPath();ctx.moveTo(-10,1);ctx.quadraticCurveTo(2,10,15,0);ctx.stroke();
}
else{
const voidy=kind.includes("void");
let g=ctx.createLinearGradient(-50,-45,55,70);g.addColorStop(0,voidy?"#514060":"#88919b");g.addColorStop(1,voidy?"#211827":"#464d55");
ctx.fillStyle=g;ctx.beginPath();ctx.moveTo(-50,0);ctx.lineTo(-28,-45);ctx.lineTo(20,-52);ctx.lineTo(52,-15);ctx.lineTo(57,45);ctx.lineTo(20,75);ctx.lineTo(-37,69);ctx.lineTo(-58,36);ctx.closePath();ctx.fill();
ctx.strokeStyle=voidy?"#8b5bc1":"#9aa4af";ctx.lineWidth=2;
ctx.beginPath();ctx.moveTo(-30,-12);ctx.lineTo(-4,5);ctx.lineTo(18,-18);ctx.stroke();
ctx.beginPath();ctx.moveTo(-20,34);ctx.lineTo(10,19);ctx.lineTo(35,39);ctx.stroke();
ctx.fillStyle=voidy?"#cc7bff":"#9cecff";ctx.fillRect(-18,-17,9,6);ctx.fillRect(11,-17,9,6);
ctx.fillStyle="#1a1a1d";ctx.fillRect(-16,-15,3,3);ctx.fillRect(13,-15,3,3);
}
ctx.restore();
}
function drawEnemy(){
if(!state.currentEnemy)return;let x=930,y=430;if(state.enemyHitAnim>0)x+=Math.sin(state.enemyHitAnim*1.8)*8;if(state.enemyAttackAnim>0)x-=Math.sin((12-state.enemyAttackAnim)/12*Math.PI)*34;
let scale=state.currentEnemy.boss?1.5:1.0;if(state.currentEnemy.kind==="earthTitan")scale=1.85;
drawMonsterShape(state.currentEnemy.kind,x,y,scale);
if(state.enemyFrozen){ctx.fillStyle="rgba(90,210,255,.18)";ctx.strokeStyle="#9fefff";ctx.lineWidth=4;ctx.beginPath();ctx.arc(x,y,92,0,Math.PI*2);ctx.fill();ctx.stroke()}
if(state.enemyBurn>0){ctx.fillStyle="rgba(255,90,30,.25)";ctx.beginPath();ctx.arc(x,y,88,0,Math.PI*2);ctx.fill()}
}

function drawLabels(){
ctx.save();ctx.fillStyle="rgba(7,10,16,.72)";ctx.fillRect(18,18,270,58);ctx.fillRect(860,18,300,58);
ctx.fillStyle="#eef4ff";ctx.font="bold 18px Arial";ctx.fillText(`Wave ${state.wave}`,34,42);ctx.font="13px Arial";ctx.fillStyle="#aebbd2";ctx.fillText(state.wave%10===0?"BOSS WAVE":"EARTH",34,62);
if(state.currentEnemy){ctx.textAlign="right";ctx.fillStyle="#eef4ff";ctx.font="bold 18px Arial";ctx.fillText(state.currentEnemy.name,1142,42);ctx.font="13px Arial";ctx.fillStyle="#aebbd2";ctx.fillText(state.currentEnemy.boss?"BOSS":"MONSTER",1142,62)}
if(pet()){ctx.textAlign="left";ctx.fillStyle="rgba(7,10,16,.68)";ctx.fillRect(245,325,230,45);ctx.fillStyle="#eef4ff";ctx.font="bold 15px Arial";ctx.fillText(pet().name,258,345);ctx.fillStyle="#aebbd2";ctx.font="11px Arial";ctx.fillText(`${pet().rank}-Rank ${pet().element}`,258,362)}
ctx.restore();
}

function gameLoop(){
ctx.save();if(state.shake>0){ctx.translate((Math.random()-.5)*state.shake,(Math.random()-.5)*state.shake);state.shake*=.75;if(state.shake<.4)state.shake=0}
drawBackground();drawHero(155,440);drawPet();drawEnemy();drawLabels();
if(state.hatchFlash>0){ctx.fillStyle=`rgba(255,255,255,${state.hatchFlash/50})`;ctx.fillRect(0,0,canvas.width,canvas.height);state.hatchFlash--}
ctx.restore();
if(state.heroAttackAnim>0)state.heroAttackAnim--;if(state.petAttackAnim>0)state.petAttackAnim--;if(state.enemyHitAnim>0)state.enemyHitAnim--;if(state.enemyAttackAnim>0)state.enemyAttackAnim--;
requestAnimationFrame(gameLoop);
}

document.getElementById("attackBtn").onclick=basicAttack;
document.getElementById("movesBtn").onclick=()=>{renderHeroMoves();openOverlay("heroMovesOverlay")};
document.getElementById("petMovesBtn").onclick=()=>{renderPetMoves();openOverlay("petMovesOverlay")};
document.getElementById("inventoryBtn").onclick=()=>{renderInventory();openOverlay("inventoryOverlay")};
document.getElementById("shopBtn").onclick=()=>{renderShop();openOverlay("shopOverlay")};
document.getElementById("closeInventory").onclick=()=>closeOverlay("inventoryOverlay");
document.getElementById("closeShop").onclick=()=>closeOverlay("shopOverlay");
document.getElementById("closeHeroMoves").onclick=()=>closeOverlay("heroMovesOverlay");
document.getElementById("closePetMoves").onclick=()=>closeOverlay("petMovesOverlay");

document.querySelectorAll("[data-invtab]").forEach(b=>b.onclick=()=>{document.querySelectorAll("[data-invtab]").forEach(x=>x.classList.remove("active"));b.classList.add("active");invTab=b.dataset.invtab;renderInventory()});
document.querySelectorAll("[data-shoptab]").forEach(b=>b.onclick=()=>{document.querySelectorAll("[data-shoptab]").forEach(x=>x.classList.remove("active"));b.classList.add("active");shopTab=b.dataset.shoptab;renderShop()});

if(!state.currentEnemy)startWave();else updateUI();
gameLoop();
</script>
</body>
</html>
