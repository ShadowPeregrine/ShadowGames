const monsters = [
  { name:"Green Slime", emoji:"🟢", hp:25, attack:5, defense:0, coins:8, xp:12 },
  { name:"Wild Rat", emoji:"🐀", hp:30, attack:6, defense:1, coins:10, xp:14 },
  { name:"Forest Bat", emoji:"🦇", hp:34, attack:7, defense:1, coins:11, xp:16 },
