<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1.0">
<title>RealmRiser</title>
<style>
*{box-sizing:border-box}
:root{
  --bg:#070b12;--panel:#111827;--panel2:#1b2537;--line:#31405c;
  --text:#eef4ff;--muted:#9eabc3;--gold:#ffd35f;--green:#58d67a;
  --red:#ef6464;--blue:#64a8ff;--purple:#b984ff;--cyan:#66e8ff;
}
body{margin:0;background:radial-gradient(circle at 20% 0,#132849 0,transparent 32%),var(--bg);color:var(--text);font-family:Arial,Helvetica,sans-serif}
button{border:0;border-radius:12px;padding:11px 14px;font-weight:900;cursor:pointer;color:#0d1320}
button:disabled{opacity:.45;cursor:not-allowed}
.hidden{display:none!important}
#app{width:min(1280px,98%);margin:auto;padding:12px 0 40px}
.topbar{display:flex;justify-content:space-between;align-items:center;gap:12px;background:rgba(17,24,39,.96);border:1px solid var(--line);border-radius:16px;padding:12px 14px;margin-bottom:10px}
.logo{font-size:30px;font-weight:1000;letter-spacing:1.3px}
.sub{font-size:12px;color:var(--muted);margin-top:3px}
.pills{display:flex;gap:7px;flex-wrap:wrap;justify-content:flex-end}
.pill{background:#202b40;border:1px solid #3a4b6a;border-radius:999px;padding:7px 10px;font-size:12px;font-weight:800}
.stage{border:1px solid var(--line);border-radius:18px;overflow:hidden;background:#111827;box-shadow:0 20px 60px rgba(0,0,0,.35)}
canvas{display:block;width:100%;background:#172235}
.hud{display:grid;grid-template-columns:1fr 1fr 1fr;gap:10px;padding:11px;background:#0f1622;border-top:1px solid var(--line)}
.hudBox{background:#151e2d;border:1px solid #293852;border-radius:12px;padding:9px}
.row{display:flex;justify-content:space-between;font-size:12px;font-weight:800;color:#cbd5e8;margin:3px 0 5px}
.bar{height:13px;background:#06090e;border:1px solid #2d3b55;border-radius:999px;overflow:hidden}
.fill{height:100%;transition:width .18s}
#heroHpFill{background:var(--green)}#enemyHpFill{background:var(--red)}#xpFill{background:var(--blue)}#chargeFill{background:linear-gradient(90deg,#8a5cff,#e0a8ff)}#petChargeFill{background:linear-gradient(90deg,#50d9ff,#88f0cb)}
.status{min-height:43px;padding:10px 13px;background:#0d131d;border-top:1px solid var(--line);font-size:13px;color:#b8c5da}
.mainControls{display:grid;grid-template-columns:repeat(5,1fr);gap:8px;padding:10px;background:#0b111b;border-top:1px solid var(--line)}
.mainControls button{padding:12px 8px}
#attackBtn{background:var(--gold)}
#movesBtn{background:#ff9872}
#petMovesBtn{background:#7be7dc}
#inventoryBtn{background:#abc8ff}
#shopBtn{background:#d4adff}

.overlay{position:fixed;inset:0;background:rgba(0,0,0,.74);display:flex;align-items:center;justify-content:center;z-index:50;padding:14px}
.modal{width:min(850px,97vw);max-height:90vh;overflow:auto;background:#151d2b;border:1px solid #3a4a68;border-radius:18px;padding:15px}
.modalHead{display:flex;justify-content:space-between;gap:10px;align-items:center;margin-bottom:12px}
.modal h2{margin:0}
.close{background:#dfe8fb}
.tabs{display:flex;gap:6px;flex-wrap:wrap;margin-bottom:11px}
.tab{background:#2a354b;color:#dce4f5;padding:8px 11px}
.tab.active{background:#dde8ff;color:#111725}
.grid{display:grid;grid-template-columns:repeat(2,1fr);gap:9px}
.card{background:#202a3d;border:1px solid #354661;border-radius:13px;padding:11px}
.card.equipped{outline:2px solid #64a8ff}
.cardTop{display:flex;justify-content:space-between;gap:8px;align-items:center}
.cardTitle{font-weight:900}
.rank{border:1px solid #62749a;border-radius:7px;padding:3px 7px;font-size:11px;font-weight:900;background:#0e1522}
.desc{font-size:12px;color:#aebbd3;line-height:1.4;margin:7px 0 10px}
.card button{width:100%;background:#dce8ff;padding:9px}
.shopCard button{background:var(--gold)}
.moveGrid{display:grid;grid-template-columns:repeat(2,1fr);gap:9px}
.moveBtn{padding:16px;text-align:left;background:#293650;color:white;border:1px solid #425475}
.moveBtn strong{display:block;font-size:15px}
.moveBtn span{display:block;color:#c1cce0;font-size:11px;margin-top:4px}
.moveBtn.locked{opacity:.45}
.eggGrid{display:grid;grid-template-columns:repeat(3,1fr);gap:10px}
.egg{background:#1e293b;border:1px solid #3a4b69;border-radius:14px;padding:12px;text-align:center}
.eggArt{height:100px;display:grid;place-items:center;margin-bottom:8px}
.eggShape{width:68px;height:86px;border-radius:50% 50% 46% 46% / 58% 58% 42% 42%;border:3px solid rgba(255,255,255,.65);box-shadow:inset 0 -10px 18px rgba(0,0,0,.25)}
.eggCommon{background:linear-gradient(#f4e4bf,#b69867)}
.eggIce{background:linear-gradient(#bff4ff,#459fe9)}
.eggStorm{background:linear-gradient(#f9e76d,#7b5be7)}
.eggVoid{background:linear-gradient(#33204d,#05040a)}
.eggDragon{background:linear-gradient(#ff9c63,#922b29)}
.eggEvent{background:linear-gradient(#ffccf6,#7d6cff)}
.egg button{width:100%;background:#dce7ff}
.rarityD{color:#cfd6df}.rarityC{color:#72d88c}.rarityB{color:#6fb4ff}.rarityA{color:#c687ff}.rarityS{color:#ffd45f}.raritySS{color:#ff9c5e}.raritySSS{color:#ff6db1}.rarityX{color:#8efcff}
.toast{position:fixed;left:50%;top:18px;transform:translateX(-50%);z-index:90;background:#111827;border:1px solid #495b7a;border-radius:12px;padding:10px 14px;font-weight:900;box-shadow:0 10px 30px rgba(0,0,0,.4)}
.worldStrip{display:grid;grid-template-columns:repeat(3,1fr);gap:9px;margin-top:10px}
.worldCard{background:#121a28;border:1px solid #2e3d57;border-radius:13px;padding:12px;text-align:center}
.worldCard.locked{opacity:.42}
.worldCard.current{outline:2px solid #64a8ff}
@media(max-width:900px){.hud{grid-template-columns:1fr}.grid,.moveGrid{grid-template-columns:1fr}.eggGrid{grid-template-columns:repeat(2,1fr)}.mainControls{grid-template-columns:repeat(2,1fr)}.mainControls button:last-child{grid-column:1/-1}}
@media(max-width:600px){.topbar{align-items:flex-start;flex-direction:column}.pills{justify-content:flex-start}.eggGrid,.worldStrip{grid-template-columns:1fr}.logo{font-size:24px}}
</style>
</head>
<body>
<div id="app">
  <div class="topbar">
    <div>
      <div class="logo">REALMRISER</div>
      <div class="sub" id="worldLabel">Earth · Wave 1</div>
    </div>
    <div class="pills">
      <div class="pill">Lv <span id="levelText">1</span></div>
      <div class="pill">Coins <span id="coinText">0</span></div>
      <div class="pill">Event <span id="eventCoinText">0</span></div>
      <div class="pill">Eggs <span id="eggCountText">0</span></div>
      <div class="pill">Pet <span id="petTopText">None</span></div>
    </div>
  </div>

  <div class="stage">
    <canvas id="game" width="1180" height="590"></canvas>

    <div class="hud">
      <div class="hudBox">
        <div class="row"><span>Hero HP</span><span id="heroHpText"></span></div>
        <div class="bar"><div id="heroHpFill" class="fill"></div></div>
        <div class="row" style="margin-top:7px"><span>XP</span><span id="xpText"></span></div>
        <div class="bar"><div id="xpFill" class="fill"></div></div>
      </div>
      <div class="hudBox">
        <div class="row"><span id="enemyNameText">Enemy</span><span id="enemyHpText"></span></div>
        <div class="bar"><div id="enemyHpFill" class="fill"></div></div>
        <div class="row" style="margin-top:7px"><span>Wave</span><span id="waveProgressText"></span></div>
      </div>
      <div class="hudBox">
        <div class="row"><span>Hero Charge</span><span id="chargeText">0 / 100</span></div>
        <div class="bar"><div id="chargeFill" class="fill"></div></div>
        <div class="row" style="margin-top:7px"><span>Pet Charge</span><span id="petChargeText">0 / 100</span></div>
        <div class="bar"><div id="petChargeFill" class="fill"></div></div>
      </div>
    </div>

    <div class="mainControls">
      <button id="attackBtn">BASIC ATTACK</button>
      <button id="movesBtn">HERO MOVES</button>
      <button id="petMovesBtn">PET MOVES</button>
      <button id="inventoryBtn">INVENTORY</button>
      <button id="shopBtn">SHOP / EGGS</button>
    </div>

    <div class="status" id="statusLine">Defeat the monsters in this wave.</div>
  </div>

  <div class="worldStrip">
    <div class="worldCard current">Earth<div class="sub">Waves 1–100</div></div>
    <div class="worldCard locked">Mushroom Planet<div class="sub">Waves 101–200</div></div>
    <div class="worldCard locked">Sun World<div class="sub">Waves 201–300</div></div>
  </div>
</div>

<div id="inventoryOverlay" class="overlay hidden">
  <div class="modal">
    <div class="modalHead">
      <div><h2>Inventory</h2><div class="sub">Equip weapons, armor, and pets.</div></div>
      <button id="closeInventory" class="close">Close</button>
    </div>
    <div class="tabs">
      <button class="tab active" data-invtab="weapons">Weapons</button>
      <button class="tab" data-invtab="armor">Armor</button>
      <button class="tab" data-invtab="pets">Pets</button>
    </div>
    <div id="inventoryGrid" class="grid"></div>
  </div>
</div>

<div id="shopOverlay" class="overlay hidden">
  <div class="modal">
    <div class="modalHead">
      <div><h2>Merchant & Hatchery</h2><div class="sub">Buy gear or hatch different kinds of eggs.</div></div>
      <button id="closeShop" class="close">Close</button>
    </div>
    <div class="tabs">
      <button class="tab active" data-shoptab="gear">Gear</button>
      <button class="tab" data-shoptab="eggs">Eggs</button>
      <button class="tab" data-shoptab="hatch">Hatch</button>
    </div>
    <div id="shopContent"></div>
  </div>
</div>

<div id="heroMovesOverlay" class="overlay hidden">
  <div class="modal">
    <div class="modalHead">
      <div><h2>Hero Moves</h2><div class="sub">Special moves need charge. Basic attacks build charge.</div></div>
      <button id="closeHeroMoves" class="close">Close</button>
    </div>
    <div id="heroMoveGrid" class="moveGrid"></div>
  </div>
</div>

<div id="petMovesOverlay" class="overlay hidden">
  <div class="modal">
    <div class="modalHead">
      <div><h2>Pet Moves</h2><div class="sub">Your equipped pet fights with you and has its own charge.</div></div>
      <button id="closePetMoves" class="close">Close</button>
    </div>
    <div id="petMoveGrid" class="moveGrid"></div>
  </div>
</div>

<div id="toast" class="toast hidden"></div>

<script>
const canvas=document.getElementById("game");
const ctx=canvas.getContext("2d");
const RANKS=["D","C","B","A","S","SS","SSS","X"];

const WEAPONS=[
{id:"wood_sword",name:"Wood Sword",rank:"D",attack:3,price:20},
{id:"iron_sword",name:"Iron Sword",rank:"D",attack:7,price:60},
{id:"hunter_blade",name:"Hunter Blade",rank:"C",attack:14,price:150},
{id:"knight_blade",name:"Knight Blade",rank:"C",attack:22,price:260},
{id:"earthsplitter",name:"Earthsplitter",rank:"B",attack:34,price:450},
{id:"titan_edge",name:"Titan Edge",rank:"B",attack:48,price:760},
{id:"voidfang",name:"Voidfang",rank:"A",attack:66,price:1250}
];

const ARMOR=[
{id:"cloth",name:"Cloth Armor",rank:"D",defense:2,hp:10,price:30},
{id:"leather",name:"Leather Armor",rank:"D",defense:5,hp:22,price:80},
{id:"iron",name:"Iron Armor",rank:"C",defense:9,hp:38,price:175},
{id:"knight",name:"Knight Armor",rank:"C",defense:14,hp:58,price:300},
{id:"guardian",name:"Guardian Plate",rank:"B",defense:21,hp:90,price:540}
];

const PETS=[
{id:"forest_wolf",name:"Forest Wolf",rank:"D",species:"wolf",element:"nature",power:6,maxHp:55,moves:["Tackle","Fang"],passive:"Quick Bite"},
{id:"frost_wolf",name:"Frost Wolf",rank:"C",species:"wolf",element:"ice",power:10,maxHp:70,moves:["Tackle","Ice Fang"],passive:"Freeze Chance"},
{id:"thunder_wolf",name:"Thunder Wolf",rank:"B",species:"wolf",element:"thunder",power:15,maxHp:82,moves:["Fang","Thunder Rush"],passive:"Shock"},
{id:"ember_drake",name:"Ember Drake",rank:"C",species:"dragon",element:"fire",power:12,maxHp:78,moves:["Claw","Flame Breath"],passive:"Burn"},
{id:"ice_dragon",name:"Ice Dragon",rank:"A",species:"dragon",element:"ice",power:22,maxHp:105,moves:["Ice Fang","Blizzard Wing"],passive:"Freeze"},
{id:"storm_dragon",name:"Storm Dragon",rank:"S",species:"dragon",element:"thunder",power:32,maxHp:128,moves:["Thunder Rush","Storm Burst"],passive:"Stun"},
{id:"void_dragon",name:"Void Dragon",rank:"SS",species:"dragon",element:"void",power:45,maxHp:150,moves:["Void Bite","Void Strike"],passive:"Life Drain"},
{id:"celestial_dragon",name:"Celestial Dragon",rank:"SSS",species:"dragon",element:"celestial",power:60,maxHp:175,moves:["Star Fang","Celestial Nova"],passive:"Heal Aura"},
{id:"abyss_wolf",name:"Abyss Wolf",rank:"X",species:"wolf",element:"void",power:80,maxHp:195,moves:["Void Fang","Abyss Howl"],passive:"Execute"}
];

const EGG_TYPES={
common:{id:"common",name:"Wild Egg",className:"eggCommon",price:90,currency:"coins",drops:[
["forest_wolf",60],["frost_wolf",25],["ember_drake",15]
]},
ice:{id:"ice",name:"Blue Ice Egg",className:"eggIce",price:220,currency:"coins",drops:[
["frost_wolf",58],["ice_dragon",35],["storm_dragon",7]
]},
storm:{id:"storm",name:"Storm Egg",className:"eggStorm",price:320,currency:"coins",drops:[
["thunder_wolf",55],["storm_dragon",38],["celestial_dragon",7]
]},
void:{id:"void",name:"Black Void Egg",className:"eggVoid",price:5,currency:"event",drops:[
["void_dragon",72],["celestial_dragon",23],["abyss_wolf",5]
]},
dragon:{id:"dragon",name:"Dragon Egg",className:"eggDragon",price:500,currency:"coins",drops:[
["ember_drake",55],["ice_dragon",30],["storm_dragon",12],["void_dragon",3]
]},
event:{id:"event",name:"Event Egg",className:"eggEvent",price:8,currency:"event",drops:[
["storm_dragon",45],["void_dragon",35],["celestial_dragon",17],["abyss_wolf",3]
]}
};

const MONSTERS=[
{name:"Crawler",kind:"crawler",hp:38,attack:6,defense:1,coins:11,xp:14},
{name:"Forest Brute",kind:"brute",hp:55,attack:8,defense:2,coins:15,xp:19},
{name:"Horn Beast",kind:"horn",hp:70,attack:10,defense:3,coins:19,xp:24},
{name:"Stone Fiend",kind:"stone",hp:90,attack:13,defense:5,coins:24,xp:30},
{name:"Night Stalker",kind:"stalker",hp:105,attack:16,defense:6,coins:29,xp:36}
];

const BOSSES=[
{wave:10,name:"Goblin Warlord",kind:"boss1"},
{wave:20,name:"Dire Beast",kind:"boss2"},
{wave:30,name:"Stone King",kind:"boss3"},
{wave:40,name:"Shadow Knight",kind:"boss4"},
{wave:50,name:"Earth Hydra",kind:"hydra"},
{wave:60,name:"Storm Griffin",kind:"griffin"},
{wave:70,name:"Dread Titan",kind:"titan"},
{wave:80,name:"Ancient Dragon",kind:"dragonboss"},
{wave:90,name:"Void Colossus",kind:"voidboss"},
{wave:100,name:"Earth Titan",kind:"earthTitan"}
];

const HERO_MOVES=[
{name:"Hunter Slash",cost:25,mult:1.6,desc:"A fast hunting strike. 1.6x damage."},
{name:"Guard Break",cost:40,mult:1.25,desc:"1.25x damage and lowers enemy defense.",effect:"break"},
{name:"Void Strike",cost:65,mult:2.7,desc:"A powerful charged void slash. 2.7x damage."},
{name:"Realm Burst",cost:100,mult:4.0,desc:"Ultimate move. 4x damage.",effect:"burst"}
];

const PET_MOVE_DATA={
"Tackle":{cost:20,mult:1.2,desc:"A quick body attack."},
"Fang":{cost:30,mult:1.6,desc:"A strong biting attack."},
"Ice Fang":{cost:35,mult:1.65,desc:"Ice bite with freeze chance.",effect:"freeze"},
"Thunder Rush":{cost:40,mult:1.8,desc:"Fast lightning rush with stun chance.",effect:"stun"},
"Claw":{cost:25,mult:1.35,desc:"Dragon claw attack."},
"Flame Breath":{cost:45,mult:1.9,desc:"Fire breath that can burn.",effect:"burn"},
"Blizzard Wing":{cost:65,mult:2.6,desc:"Icy wing blast with high freeze chance.",effect:"freezeStrong"},
"Storm Burst":{cost:70,mult:2.8,desc:"Explosive thunder attack.",effect:"stunStrong"},
"Void Bite":{cost:45,mult:2.0,desc:"Void bite that drains life.",effect:"drain"},
"Void Strike":{cost:80,mult:3.2,desc:"Massive void attack.",effect:"void"},
"Star Fang":{cost:50,mult:2.1,desc:"Celestial fang attack."},
"Celestial Nova":{cost:90,mult:3.5,desc:"Celestial explosion that heals the hero.",effect:"heal"},
"Void Fang":{cost:55,mult:2.4,desc:"Abyss-powered fang."},
"Abyss Howl":{cost:100,mult:4.4,desc:"X-rank ultimate howl.",effect:"execute"}
};

function fresh(){
return{
world:"Earth",wave:1,level:1,xp:0,xpNeed:50,coins:120,eventCoins:0,
baseHp:120,hp:120,baseAttack:11,baseDefense:1,potions:3,
weapons:["wood_sword"],armor:[],pets:[],
eqWeapon:"wood_sword",eqArmor:null,eqPet:null,
eggs:{common:1,ice:0,storm:0,void:0,dragon:0,event:0},
heroCharge:0,petCharge:0,
enemiesTotal:0,enemiesLeft:0,currentEnemy:null,currentEnemyHp:0,currentEnemyDefense:0,
enemyFrozen:false,enemyStunned:false,enemyBurn:0,
battleOver:false,betweenEnemies:false,
heroAttackAnim:0,petAttackAnim:0,enemyHitAnim:0,enemyAttackAnim:0,shake:0,
hatchFlash:0
};
}
let state=load()||fresh();
let invTab="weapons";
let shopTab="gear";

function save(){localStorage.setItem("realmRiserUltimateV1",JSON.stringify(state))}
function load(){try{const x=localStorage.getItem("realmRiserUltimateV1");return x?JSON.parse(x):null}catch(e){return null}}
function rankIndex(r){return RANKS.indexOf(r)}
function weapon(){return WEAPONS.find(x=>x.id===state.eqWeapon)}
function armor(){return ARMOR.find(x=>x.id===state.eqArmor)}
function pet(){return PETS.find(x=>x.id===state.eqPet)}
function maxHp(){return state.baseHp+(armor()?.hp||0)}
function heroAttack(){return state.baseAttack+(weapon()?.attack||0)}
function heroDefense(){return state.baseDefense+(armor()?.defense||0)}
function setStatus(t){document.getElementById("statusLine").textContent=t}
function toast(t){const el=document.getElementById("toast");el.textContent=t;el.classList.remove("hidden");setTimeout(()=>el.classList.add("hidden"),1500)}
function waveEnemyCount(){return state.wave%10===0?1:3+Math.min(3,Math.floor(state.wave/8))}

function startWave(){
state.enemiesTotal=waveEnemyCount();
state.enemiesLeft=state.enemiesTotal;
state.battleOver=false;state.betweenEnemies=false;
spawnEnemy();setStatus(state.wave%10===0?`Boss Wave ${state.wave}!`:`Wave ${state.wave} begins.`);
save();
}
function spawnEnemy(){
const bossInfo=BOSSES.find(b=>b.wave===state.wave);
const scale=1+(state.wave-1)*0.095;
if(bossInfo){
state.currentEnemy={
name:bossInfo.name,kind:bossInfo.kind,boss:true,
maxHp:Math.round((200+state.wave*18)*scale),
attack:Math.round((15+state.wave*1.45)*(1+state.wave*.015)),
defense:Math.round(5+state.wave*.35),
coins:Math.round(100+state.wave*13),xp:Math.round(100+state.wave*10)
};
}else{
const t=MONSTERS[Math.min(MONSTERS.length-1,Math.floor((state.wave-1)/4))];
state.currentEnemy={
name:t.name,kind:t.kind,boss:false,maxHp:Math.round(t.hp*scale),
attack:Math.round(t.attack*(1+state.wave*.05)),
defense:Math.round(t.defense+state.wave*.14),
coins:Math.round(t.coins*(1+state.wave*.05)),
xp:Math.round(t.xp*(1+state.wave*.04))
};
}
state.currentEnemyHp=state.currentEnemy.maxHp;
state.currentEnemyDefense=state.currentEnemy.defense;
state.enemyFrozen=false;state.enemyStunned=false;state.enemyBurn=0;
updateUI();
}

function gainXp(xp){
state.xp+=xp;
while(state.xp>=state.xpNeed){
state.xp-=state.xpNeed;state.level++;state.xpNeed=Math.round(state.xpNeed*1.22);
state.baseHp+=13;state.baseAttack+=3;state.baseDefense+=1;state.hp=maxHp();
toast(`LEVEL UP! Level ${state.level}`);
}
}

function basicAttack(){
if(blocked())return;
let dmg=Math.max(1,heroAttack()-state.currentEnemyDefense+Math.floor(Math.random()*5));
if(Math.random()<.12)dmg=Math.round(dmg*1.7);
state.heroCharge=Math.min(100,state.heroCharge+18);
state.petCharge=Math.min(100,state.petCharge+(pet()?10:0));
state.heroAttackAnim=13;state.enemyHitAnim=8;
damageEnemy(dmg,`Basic attack dealt ${dmg} damage.`);
if(state.currentEnemyHp>0)setTimeout(()=>petAutoAttack(),220);
}

function useHeroMove(move){
if(blocked()||state.heroCharge<move.cost)return;
state.heroCharge-=move.cost;
let dmg=Math.max(1,Math.round((heroAttack()-state.currentEnemyDefense*.45)*move.mult));
if(move.effect==="break")state.currentEnemyDefense=Math.max(0,state.currentEnemyDefense-4);
state.heroAttackAnim=18;state.enemyHitAnim=10;state.shake=move.cost>=65?8:3;
damageEnemy(dmg,`${move.name} dealt ${dmg} damage!`);
closeOverlay("heroMovesOverlay");
if(state.currentEnemyHp>0)setTimeout(()=>petAutoAttack(),260);
}

function petAutoAttack(){
const p=pet();
if(!p||blocked()||state.currentEnemyHp<=0){if(state.currentEnemyHp>0)setTimeout(enemyTurn,250);return}
let dmg=Math.max(1,p.power+Math.floor(Math.random()*4)-Math.round(state.currentEnemyDefense*.22));
state.petAttackAnim=16;state.enemyHitAnim=6;state.petCharge=Math.min(100,state.petCharge+18);
damageEnemy(dmg,`${p.name} attacks for ${dmg} damage.`);
if(state.currentEnemyHp>0)setTimeout(enemyTurn,250);
}

function usePetMove(name){
const p=pet();if(!p||blocked())return;
const mv=PET_MOVE_DATA[name];if(!mv||state.petCharge<mv.cost)return;
state.petCharge-=mv.cost;
let dmg=Math.max(1,Math.round((p.power+4)*mv.mult-state.currentEnemyDefense*.18));
state.petAttackAnim=22;state.enemyHitAnim=12;state.shake=mv.cost>=65?8:4;
if(mv.effect==="freeze"&&Math.random()<.45)state.enemyFrozen=true;
if(mv.effect==="freezeStrong"&&Math.random()<.75)state.enemyFrozen=true;
if(mv.effect==="stun"&&Math.random()<.45)state.enemyStunned=true;
if(mv.effect==="stunStrong"&&Math.random()<.7)state.enemyStunned=true;
if(mv.effect==="burn")state.enemyBurn=3;
if(mv.effect==="drain")state.hp=Math.min(maxHp(),state.hp+Math.round(dmg*.25));
if(mv.effect==="heal")state.hp=Math.min(maxHp(),state.hp+Math.round(maxHp()*.15));
if(mv.effect==="execute"&&state.currentEnemyHp/state.currentEnemy.maxHp<.25)dmg=Math.round(dmg*2);
damageEnemy(dmg,`${p.name} used ${name} for ${dmg} damage!`);
closeOverlay("petMovesOverlay");
if(state.currentEnemyHp>0)setTimeout(enemyTurn,280);
}

function damageEnemy(dmg,msg){
state.currentEnemyHp=Math.max(0,state.currentEnemyHp-dmg);setStatus(msg);
if(state.currentEnemyHp<=0)defeatEnemy();updateUI();
}

function enemyTurn(){
if(blocked()||state.currentEnemyHp<=0)return;
if(state.enemyBurn>0){
const burn=Math.max(3,Math.round(state.currentEnemy.maxHp*.035));
state.currentEnemyHp=Math.max(0,state.currentEnemyHp-burn);state.enemyBurn--;
setStatus(`${state.currentEnemy.name} takes ${burn} burn damage.`);
if(state.currentEnemyHp<=0){defeatEnemy();return}
}
if(state.enemyFrozen){state.enemyFrozen=false;setStatus(`${state.currentEnemy.name} is frozen and misses its turn.`);updateUI();return}
if(state.enemyStunned){state.enemyStunned=false;setStatus(`${state.currentEnemy.name} is stunned and misses its turn.`);updateUI();return}
const dmg=Math.max(1,state.currentEnemy.attack-heroDefense()+Math.floor(Math.random()*4));
state.hp=Math.max(0,state.hp-dmg);state.enemyAttackAnim=12;state.shake=6;
setStatus(`${state.currentEnemy.name} hits you for ${dmg}.`);
if(state.hp<=0){
const lost=Math.floor(state.coins*.1);state.coins-=lost;state.hp=maxHp();state.heroCharge=0;state.petCharge=0;
setStatus(`You were defeated. Lost ${lost} coins. Restarting wave...`);
setTimeout(startWave,800);
}
updateUI();save();
}

function defeatEnemy(){
const e=state.currentEnemy;state.coins+=e.coins;gainXp(e.xp);
if(e.boss&&Math.random()<.55){state.eventCoins+=state.wave===100?4:1;toast("Boss dropped Event Coin!")}
if(e.boss&&Math.random()<.35){const type=state.wave>=80?"void":state.wave>=40?"dragon":"ice";state.eggs[type]=(state.eggs[type]||0)+1;toast(`${EGG_TYPES[type].name} dropped!`)}
state.enemiesLeft--;
if(state.enemiesLeft<=0){
state.battleOver=true;const bonus=25+state.wave*5;state.coins+=bonus;
setStatus(`Wave ${state.wave} cleared! +${bonus} bonus coins.`);
if(state.wave===100){toast("EARTH COMPLETE! Mushroom Planet coming next.");save();updateUI();return}
state.wave++;state.hp=Math.min(maxHp(),state.hp+Math.round(maxHp()*.2));state.heroCharge=Math.min(100,state.heroCharge+15);state.petCharge=Math.min(100,state.petCharge+15);save();setTimeout(startWave,1000);
}else{
state.betweenEnemies=true;setStatus(`Enemy defeated. ${state.enemiesLeft} left.`);
save();setTimeout(()=>{state.betweenEnemies=false;spawnEnemy()},650);
}
updateUI();
}

function usePotion(){
if(state.potions<=0||state.hp>=maxHp())return;
const heal=Math.round(maxHp()*.42);const before=state.hp;state.hp=Math.min(maxHp(),state.hp+heal);state.potions--;
setStatus(`Potion restored ${state.hp-before} HP.`);updateUI();save();
}
function blocked(){return state.battleOver||state.betweenEnemies||!state.currentEnemy}

function buyGear(item){
if(state.coins<item.price){toast("Not enough coins");return}
const owned=state.weapons.includes(item.id)||state.armor.includes(item.id);
if(owned)return;
state.coins-=item.price;
if(WEAPONS.includes(item))state.weapons.push(item.id);else state.armor.push(item.id);
toast(`Bought ${item.name}`);updateUI();renderShop();
}
function buyEgg(type){
const e=EGG_TYPES[type];
if(e.currency==="coins"){
if(state.coins<e.price){toast("Not enough coins");return}
state.coins-=e.price;
}else{
if(state.eventCoins<e.price){toast("Not enough Event Coins");return}
state.eventCoins-=e.price;
}
state.eggs[type]=(state.eggs[type]||0)+1;toast(`Bought ${e.name}`);updateUI();renderShop();
}
function hatchEgg(type){
if((state.eggs[type]||0)<=0){toast("You do not have that egg");return}
state.eggs[type]--;const drops=EGG_TYPES[type].drops;
let roll=Math.random()*100,acc=0,pick=drops[0][0];
for(const [id,chance] of drops){acc+=chance;if(roll<=acc){pick=id;break}}
const p=PETS.find(x=>x.id===pick);
if(!state.pets.includes(p.id))state.pets.push(p.id);
state.hatchFlash=40;toast(`HATCHED: ${p.rank}-Rank ${p.name}!`);
setStatus(`You hatched ${p.name}! Open Inventory → Pets to equip it.`);
updateUI();renderShop();save();
}

function equip(type,id){
if(type==="weapons")state.eqWeapon=id;
if(type==="armor"){
const before=maxHp();state.eqArmor=id;const after=maxHp();state.hp=Math.min(after,state.hp+Math.max(0,after-before));
}
if(type==="pets"){state.eqPet=id;state.petCharge=0}
updateUI();renderInventory();save();
}

function openOverlay(id){document.getElementById(id).classList.remove("hidden")}
function closeOverlay(id){document.getElementById(id).classList.add("hidden")}

function renderInventory(){
const grid=document.getElementById("inventoryGrid");grid.innerHTML="";
let catalog,owned,eq;
if(invTab==="weapons"){catalog=WEAPONS;owned=state.weapons;eq=state.eqWeapon}
else if(invTab==="armor"){catalog=ARMOR;owned=state.armor;eq=state.eqArmor}
else{catalog=PETS;owned=state.pets;eq=state.eqPet}
if(owned.length===0){grid.innerHTML='<div class="card"><div class="desc">Nothing here yet.</div></div>';return}
owned.map(id=>catalog.find(x=>x.id===id)).filter(Boolean).sort((a,b)=>rankIndex(b.rank)-rankIndex(a.rank)).forEach(item=>{
const card=document.createElement("div");card.className="card"+(eq===item.id?" equipped":"");
let desc="";
if(invTab==="weapons")desc=`+${item.attack} Attack`;
else if(invTab==="armor")desc=`+${item.defense} Defense · +${item.hp} HP`;
else desc=`${item.species.toUpperCase()} · ${item.element} · Power ${item.power}<br>Moves: ${item.moves.join(", ")}<br>Passive: ${item.passive}`;
card.innerHTML=`<div class="cardTop"><div class="cardTitle">${item.name}</div><span class="rank rarity${item.rank}">${item.rank}</span></div><div class="desc">${desc}</div><button ${eq===item.id?"disabled":""}>${eq===item.id?"Equipped":"Equip"}</button>`;
card.querySelector("button").onclick=()=>equip(invTab,item.id);grid.appendChild(card);
});
}

function renderShop(){
const box=document.getElementById("shopContent");box.innerHTML="";
if(shopTab==="gear"){
const grid=document.createElement("div");grid.className="grid";
[...WEAPONS,...ARMOR].filter(i=>rankIndex(i.rank)<=Math.min(3,Math.floor(state.wave/25))).forEach(item=>{
const owned=state.weapons.includes(item.id)||state.armor.includes(item.id);
const card=document.createElement("div");card.className="card shopCard";
const d=WEAPONS.includes(item)?`+${item.attack} Attack`:`+${item.defense} Defense · +${item.hp} HP`;
card.innerHTML=`<div class="cardTop"><div class="cardTitle">${item.name}</div><span class="rank rarity${item.rank}">${item.rank}</span></div><div class="desc">${d}</div><button ${owned?"disabled":""}>${owned?"Owned":`Buy · ${item.price} coins`}</button>`;
card.querySelector("button").onclick=()=>buyGear(item);grid.appendChild(card);
});
const pot=document.createElement("div");pot.className="card shopCard";pot.innerHTML=`<div class="cardTitle">Health Potion</div><div class="desc">Restores 42% max HP.</div><button>Buy · 40 coins</button>`;
pot.querySelector("button").onclick=()=>{if(state.coins<40){toast("Not enough coins");return}state.coins-=40;state.potions++;toast("Potion bought");updateUI();renderShop()};grid.appendChild(pot);
box.appendChild(grid);
}
if(shopTab==="eggs"){
const grid=document.createElement("div");grid.className="eggGrid";
Object.values(EGG_TYPES).forEach(e=>{
const d=document.createElement("div");d.className="egg";
d.innerHTML=`<div class="eggArt"><div class="eggShape ${e.className}"></div></div><div class="cardTitle">${e.name}</div><div class="desc">${e.currency==="coins"?e.price+" coins":e.price+" Event Coins"}<br>Possible pets: ${e.drops.map(x=>PETS.find(p=>p.id===x[0]).name).join(", ")}</div><button>Buy Egg</button>`;
d.querySelector("button").onclick=()=>buyEgg(e.id);grid.appendChild(d);
});
box.appendChild(grid);
}
if(shopTab==="hatch"){
const grid=document.createElement("div");grid.className="eggGrid";
Object.values(EGG_TYPES).forEach(e=>{
const count=state.eggs[e.id]||0;
const d=document.createElement("div");d.className="egg";
d.innerHTML=`<div class="eggArt"><div class="eggShape ${e.className}"></div></div><div class="cardTitle">${e.name}</div><div class="desc">Owned: ${count}</div><button ${count<=0?"disabled":""}>HATCH</button>`;
d.querySelector("button").onclick=()=>hatchEgg(e.id);grid.appendChild(d);
});
box.appendChild(grid);
}
}

function renderHeroMoves(){
const grid=document.getElementById("heroMoveGrid");grid.innerHTML="";
HERO_MOVES.forEach(m=>{
const b=document.createElement("button");b.className="moveBtn"+(state.heroCharge<m.cost?" locked":"");
b.disabled=state.heroCharge<m.cost||blocked();
b.innerHTML=`<strong>${m.name} · ${m.cost} Charge</strong><span>${m.desc}</span>`;
b.onclick=()=>useHeroMove(m);grid.appendChild(b);
});
}

function renderPetMoves(){
const grid=document.getElementById("petMoveGrid");grid.innerHTML="";const p=pet();
if(!p){grid.innerHTML='<div class="card"><div class="desc">No pet equipped. Hatch an egg and equip a pet first.</div></div>';return}
p.moves.forEach(name=>{
const m=PET_MOVE_DATA[name];const b=document.createElement("button");b.className="moveBtn"+(state.petCharge<m.cost?" locked":"");
b.disabled=state.petCharge<m.cost||blocked();
b.innerHTML=`<strong>${name} · ${m.cost} Charge</strong><span>${m.desc}</span>`;
b.onclick=()=>usePetMove(name);grid.appendChild(b);
});
}

