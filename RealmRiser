document.getElementById("worldLabel").textContent=`${state.world} · Wave ${state.wave}`;
document.getElementById("levelText").textContent=state.level;
document.getElementById("coinText").textContent=state.coins;
document.getElementById("eventCoinText").textContent=state.eventCoins;
document.getElementById("eggCountText").textContent=Object.values(state.eggs).reduce((a,b)=>a+b,0);
document.getElementById("petTopText").textContent=pet()?.name||"None";
document.getElementById("heroHpText").textContent=`${state.hp} / ${maxHp()}`;
